{
  "name": "pina-game",
  "private": true,
  "version": "1.0.0",
  "author": "Ronmo",
  "description": "Meu Jogo Pina",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.ronmo.pinagame",
    "productName": "Pina Game",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "index.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icone.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pina Game"
    }
  }
}